# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# IA (console.anthropic.com) — só no servidor, nunca vai para o navegador
ANTHROPIC_API_KEY=sk-ant-...
# Opcionais
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=30
# Preço em US$ por milhão de tokens, para registrar custo em ai_usage (deixe vazio para não calcular)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
